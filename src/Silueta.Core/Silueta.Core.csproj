<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Two targets, and only here. The library is what other people's backends depend on, and the first
         one to ask for it runs .NET 9 — which leaves support on 10 November 2026, so this is a bridge,
         not a promise. The CLI, the MCP server, the web demo and the calibration tool stay on net10.0:
         they are programs somebody runs, not dependencies somebody builds against. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Detector packs are read via reflection from embedded resources; keep them addressable under
         a trimmed WebAssembly build, which is how the browser demo runs with nothing uploaded. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <PackageId>Silueta.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>Pedro Hernández (PeopleWorks)</Authors>
    <Company>PeopleWorks</Company>
    <Description>De-identification for conversation transcripts, so they can be analysed by an AI without carrying the people in them. Built for text that came out of a speech recogniser: it matches the identifiers you already know through ASR spelling damage, replaces names with consistent invented names under a HIPAA Safe Harbor policy, and measures its own leak rate. No external dependencies.</Description>
    <PackageTags>deidentification;phi;hipaa;privacy;transcripts;asr;anonymization;nlp</PackageTags>
    <PackageProjectUrl>https://github.com/peopleworks/Silueta</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peopleworks/Silueta</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- A wildcard, so adding a pattern pack is adding a file: extension points are JSON anyone can
         send by pull request, never compiled code. WithCulture=false is essential — filenames like
         patterns.core.json would otherwise be mistaken for culture-specific satellite resources and
         dropped from the main assembly manifest. LogicalName pins the reflection lookup name. -->
    <EmbeddedResource Include="Detectors\Packs\patterns.*.json" WithCulture="false">
      <LogicalName>Silueta.Core.Detectors.Packs.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- The default lineage: the word lists and the labels, as data. Same WithCulture trick, and for the
         same reason — lineage.core.json parses as a culture-tagged satellite resource otherwise. -->
    <EmbeddedResource Include="Lineage\Lineages\lineage.*.json" WithCulture="false">
      <LogicalName>Silueta.Core.Lineage.Lineages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- The words a linkage report counts as surviving quasi-identifiers. Data, like the lineage. -->
    <EmbeddedResource Include="Evaluation\Vocabulary\*.json" WithCulture="false">
      <LogicalName>Silueta.Core.Evaluation.Vocabulary.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- How often this build leaves an identifier behind, so a manifest can carry its own error rate with no
         corpus, no file path and no network call. Regenerated by tools/Silueta.Calibration in the same run
         that rewrites the README's published block. A condition, not a hard reference: a fork that has never
         measured itself must still build, and then says so at runtime instead of quoting somebody else's
         number. -->
    <EmbeddedResource Include="Evaluation\published-leak-rate.json" WithCulture="false"
                      LogicalName="Silueta.Core.Evaluation.published-leak-rate.json"
                      Condition="Exists('Evaluation\published-leak-rate.json')" />
  </ItemGroup>

</Project>
