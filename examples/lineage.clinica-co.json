{
  "_about": [
    "A clinic in Colombia, and the point of the file: the rules this library ships with are American and",
    "Mexican, and a project somewhere else brings its own words. \"lists\" holds them, and its own rules name",
    "them exactly as the built-in rules name theirs — and may name the built-in ones too, so the months do",
    "not have to be written again. Run silueta lists to see what is already there."
  ],

  "lineage": "clinica-ejemplo-co",
  "version": "1",
  "language": "es-CO",

  "pools": {
    "given": ["Ale", "Ariel", "Cruz", "Noa", "Quinn", "Remy", "Sol", "Yael"],
    "family": ["Bravo", "Duarte", "Fuentes", "Herrera", "Medina", "Ochoa", "Prado", "Salazar"]
  },

  "labels": {
    "PatientName": "[PACIENTE]",
    "FamilyName": "[FAMILIAR]",
    "StaffName": "[PERSONAL]",
    "Phone": "[TELÉFONO]",
    "Email": "[CORREO]",
    "Address": "[DIRECCIÓN]",
    "City": "[CIUDAD]",
    "State": "[DEPARTAMENTO]",
    "Date": "[FECHA]",
    "AgeOver89": "[90+]",
    "RecordNumber": "[HISTORIA]"
  },

  "generalizations": {
    "AgeOver89": "90 o más"
  },

  "lists": {
    "departamento-co": [
      "Amazonas", "Antioquia", "Arauca", "Atlántico", "Bolívar", "Boyacá", "Caldas", "Caquetá", "Casanare",
      "Cauca", "Cesar", "Chocó", "Córdoba", "Cundinamarca", "Guainía", "Guaviare", "Huila", "La Guajira",
      "Magdalena", "Meta", "Nariño", "Norte de Santander", "Putumayo", "Quindío", "Risaralda", "San Andrés",
      "Santander", "Sucre", "Tolima", "Valle del Cauca", "Vaupés", "Vichada"
    ],
    "via-co": [
      "Calle", "Carrera", "Diagonal", "Transversal", "Avenida", "Autopista", "Circunvalar", "Kilómetro"
    ]
  },

  "values": {
    "City": ["Medellín", "Envigado", "Itagüí", "Sabaneta", "Bello"]
  },

  "policies": {
    "estadistica": {
      "version": "1",
      "actions": { "Date": "Keep", "City": "Keep" }
    }
  },

  "_patterns": [
    "These replace the built-in pack, so the ones this clinic still wants are written here too — and the",
    "ones that need a word list name it: {{departamento-co}} is declared above, {{month-es}} is the",
    "library's. A rule naming a list nobody declared is skipped and reported in the manifest."
  ],
  "patterns": [
    { "id": "correo", "kind": "Email", "regex": "\\b[\\w.%+-]+@[\\w.-]+\\.[A-Za-z]{2,}\\b", "confidence": 0.99 },
    { "id": "telefono-co", "kind": "Phone", "regex": "(?<!\\d)(?:\\+?57[ -]?)?(?:3\\d{2}|60\\d)[ -]?\\d{3}[ -]?\\d{4}(?!\\d)", "confidence": 0.9 },
    { "id": "historia-clinica", "kind": "RecordNumber", "regex": "\\b(?:historia(?:\\s+cl[íi]nica)?|hc)\\s*[:#]?\\s*\\d{5,12}\\b", "confidence": 0.95 },
    { "id": "fecha-es", "kind": "Date", "regex": "\\b\\d{1,2}\\s+de\\s+{{month-es}}(?:\\s+de\\s+\\d{4})?\\b", "confidence": 0.9 },
    { "id": "departamento-co", "kind": "State", "regex": "\\b{{departamento-co}}\\b", "confidence": 0.9 },
    { "id": "ciudad-co", "kind": "City", "regex": "(?-i:\\b\\p{Lu}\\p{Ll}+(?:\\s\\p{Lu}\\p{Ll}+){0,2})(?=,\\s+{{departamento-co}}\\b)", "confidence": 0.9 },
    { "id": "direccion-co", "kind": "Address", "regex": "\\b{{via-co}}\\s+\\d{1,3}\\s*[A-Za-z]?\\s*#\\s*\\d{1,3}\\s*[A-Za-z]?\\s*-\\s*\\d{1,3}\\b", "confidence": 0.9 }
  ]
}
